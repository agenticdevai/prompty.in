# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key       # server-side only — never expose to client

# ─── Cloudflare R2 ───────────────────────────────────────────────────────────
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=prompty-images
R2_PUBLIC_URL=https://images.prompty.in                # CDN URL prefix

# ─── Upstash Redis ───────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://your-redis.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# ─── Anthropic (Claude Haiku classifier) ─────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Resend (transactional email) ────────────────────────────────────────────
RESEND_API_KEY=re_...

# ─── PostHog (analytics) ─────────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── Razorpay (payments) ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_...
RAZORPAY_KEY_SECRET=your-razorpay-secret

# ─── App ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://prompty.in
NEXT_PUBLIC_APP_ENV=development                        # development | staging | production
ADMIN_USER_IDS=                                        # comma-separated Supabase UUID list
